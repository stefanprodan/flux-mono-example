# Mirror of kubernetes/clusters/dev/flux-vars.yaml (used by make vet).
env=dev
cluster_registry=flux-registry:5000
app_registry=flux-registry:5000
app_registry_insecure=true
cluster_name=kind-flux
# App env parameters, set per app env via postBuild.substitute in
# kubernetes/clusters/<cluster>/apps-<env>-reconcilers.yaml (values here only for make vet).
app_env=test
app_semver='x || >=0.0.0-0'
